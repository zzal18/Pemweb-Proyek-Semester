# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env ke Git.
# Jangan menulis komentar di baris yang sama dengan nilai (parser cadangan di src/Env.php tidak mendukungnya).

# local = Laragon (debug boleh aktif) | staging | production
APP_ENV=production

# Detail error hanya tampil jika APP_ENV=local DAN APP_DEBUG=true. Di production SELALU false.
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_NAME=nama_database
DB_USER=user_database
DB_PASS=ganti_dengan_password_kuat

# Batas panjang nama menu (karakter)
MAX_NAMA_MENU=100